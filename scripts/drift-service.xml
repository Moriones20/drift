<?xml version="1.0" encoding="UTF-8"?>
<!--
  WinSW service descriptor for the Drift forex bot.

  Convention: this file must be placed alongside the renamed WinSW binary,
  both sharing the base name "drift-service":
      scripts\drift-service.exe   <- WinSW binary (download separately, see below)
      scripts\drift-service.xml   <- this file

  WinSW resolves relative paths against %BASE%, which is the directory that
  contains the .exe — i.e. <repo root>\scripts\.  All relative paths below
  are therefore relative to <repo root>\scripts\.

  HOW TO OBTAIN WinSW:
      Download WinSW-x64.exe from:
          https://github.com/winsw/winsw/releases/tag/v2.12.0
      Rename the downloaded file to "drift-service.exe" and place it in
      this directory (scripts\).  Then run install-service.ps1.
-->

<service>

  <!-- =====================================================================
       Identity and description
  ====================================================================== -->

  <!-- Internal Windows service name (no spaces; used by sc.exe / services.msc). -->
  <id>Drift</id>

  <!-- Human-readable name visible in services.msc. -->
  <name>Drift</name>

  <!-- Description shown in the services.msc detail pane. -->
  <description>Drift autonomous forex bot (Asian Session Scalper). Managed by WinSW.</description>


  <!-- =====================================================================
       Executable
       WinSW does not support %BASE% expansion in <executable>, so the
       install-service.ps1 script rewrites this element with the absolute
       path to python.exe before calling "drift-service.exe install".
       The placeholder below is replaced by the installer.
  ====================================================================== -->

  <!-- Absolute path to python.exe — set by install-service.ps1 at install time. -->
  <executable>PYTHON_EXE_PLACEHOLDER</executable>

  <!-- Arguments passed to python.exe. -->
  <!-- %BASE% expands to the directory containing drift-service.exe (scripts\).
       main.py lives one level up, so we use ..\main.py. -->
  <arguments>..\main.py</arguments>


  <!-- =====================================================================
       Working directory
       Set to the repo root so all relative paths in main.py (config.yaml,
       data\, logs\) resolve correctly.  %BASE% is scripts\, so ..\ is the
       repo root.
  ====================================================================== -->
  <workingdirectory>%BASE%\..</workingdirectory>


  <!-- =====================================================================
       Startup mode
       "Automatic" means Windows starts the service on every boot.
  ====================================================================== -->
  <startmode>Automatic</startmode>


  <!-- =====================================================================
       Failure / auto-restart policy

       Three <onfailure> elements define what happens on the 1st, 2nd, and
       subsequent failures respectively.  All use restart with a 10-second
       delay so a crash-loop does not hammer the system.

       <resetfailure> defines the window (in seconds) after which the failure
       counter resets if the service has been running stably.  1 hour (3600s)
       means that if the bot runs for >1 h without dying, the next failure is
       treated as the "first" again.
  ====================================================================== -->

  <!-- First failure: restart after 10 s. -->
  <onfailure action="restart" delay="10 sec"/>

  <!-- Second failure: restart after 30 s (slight backoff). -->
  <onfailure action="restart" delay="30 sec"/>

  <!-- All subsequent failures: restart after 60 s. -->
  <onfailure action="restart" delay="60 sec"/>

  <!-- Reset the failure counter after 1 hour of stable operation. -->
  <resetfailure>3600</resetfailure>


  <!-- =====================================================================
       Log rotation
       WinSW captures the process stdout+stderr and writes them to log files.
       mode="roll-by-size" rotates when the active log exceeds sizeThreshold
       bytes and keeps keepFiles rotated copies alongside it.

       Paths are relative to %BASE% (scripts\).  We write to ..\logs\ so the
       service log lands next to drift.log.
  ====================================================================== -->
  <log mode="roll-by-size">
    <!-- Directory where WinSW writes its log files. -->
    <logpath>%BASE%\..\logs</logpath>

    <!-- Rotate at 10 MB. -->
    <sizeThreshold>10240</sizeThreshold>

    <!-- Keep up to 5 rotated copies (service-drift-service.out.log.1 … .5). -->
    <keepFiles>5</keepFiles>
  </log>


  <!-- =====================================================================
       Environment variable injected into the bot process.
       Ensures Python's stdout/stderr are not buffered so log output is
       visible in the WinSW-captured log files in near real-time.
  ====================================================================== -->
  <env name="PYTHONUNBUFFERED" value="1"/>

</service>
